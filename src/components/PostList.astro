---
import type { CollectionEntry } from 'astro:content';
import { formatDate, postUrl, tagUrl } from '../lib/posts';
interface Props { posts: CollectionEntry<'posts'>[]; }
const { posts } = Astro.props;
---
<div class="post-list">
  {posts.map(post => <article class="post-row">
    <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
    <div><h3><a href={postUrl(post.data.slug)}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="post-tags">{post.data.tags.map(tag => <a href={tagUrl(tag)}>#{tag}</a>)}</div></div>
    <a class="row-arrow" href={postUrl(post.data.slug)} aria-label={`阅读 ${post.data.title}`}>↗</a>
  </article>)}
</div>
