---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import { siteName } from '../lib/site';

const [lead, ...posts] = await getPosts();
const recent = posts.slice(0, 2);
const archive = posts.slice(2);
---
<Base>
  <div class="shell home-feed">
    <h1 class="visually-hidden">{siteName}</h1>
    {lead && (
      <div class:list={['home-lead', { 'home-lead-split': recent.length > 0 }]}>
        <PostList posts={[lead]} layout="lead" />
        {recent.length > 0 && <PostList posts={recent} layout="compact" />}
      </div>
    )}
    {archive.length > 0 && (
      <div class="reading-width home-archive">
        <PostList posts={archive} />
      </div>
    )}
  </div>
</Base>
