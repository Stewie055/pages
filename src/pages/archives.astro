---
import Base from '../layouts/Base.astro';
import { getPosts, postUrl, formatDate } from '../lib/posts';
const posts = await getPosts();
const years = [...new Set(posts.map(post => post.data.date.getUTCFullYear()))];
---
<Base title="归档">
  <div class="reading-width listing-page">
    <header class="page-heading"><h1>归档</h1></header>
    {years.map(year => (
      <section class="archive-year">
        <h2>{year}</h2>
        <ul class="archive-list">
          {posts.filter(post => post.data.date.getUTCFullYear() === year).map(({ data }) => (
            <li>
              <a href={postUrl(data.slug)}>
                <time datetime={formatDate(data.date)}>{formatDate(data.date).slice(5)}</time>
                <span>{data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
