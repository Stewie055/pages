---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts, postUrl, tagUrl, formatDate } from '../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.data.slug }, props: { post, previous: posts[i + 1], next: posts[i - 1] } }));
}
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(heading => heading.depth <= 3);
const minutes = Math.max(1, Math.ceil((post.body || '').length / 600));
---
<Base title={post.data.title} description={post.data.description} article>
  <article class="article-page" data-pagefind-body>
    <header class="article-header">
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <div class="article-meta" data-pagefind-ignore>
        <a href="/about/">Erossr</a>
        <time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
        <span>约 {minutes} 分钟阅读</span>
        {post.data.updated && <span>更新于 <time datetime={formatDate(post.data.updated)}>{formatDate(post.data.updated)}</time></span>}
      </div>
    </header>
    <div class="article-grid">
      <div class="article-content">
        <div class="prose"><Content /></div>
        {post.data.tags.length > 0 && (
          <ul class="post-tags article-tags" aria-label="文章标签" data-pagefind-ignore>
            {post.data.tags.map(tag => <li><a href={tagUrl(tag)}>{tag}</a></li>)}
          </ul>
        )}
        {(previous || next) && (
          <nav class="article-pagination" aria-label="相邻文章" data-pagefind-ignore>
            {previous && <a href={postUrl(previous.data.slug)} rel="prev"><small>← 更早一篇</small>{previous.data.title}</a>}
            {next && <a href={postUrl(next.data.slug)} rel="next"><small>较新一篇 →</small>{next.data.title}</a>}
          </nav>
        )}
      </div>
      {tocHeadings.length > 0 && (
        <nav class="toc" aria-label="文章目录" data-pagefind-ignore>
          <p>目录</p>
          <ul>
            {tocHeadings.map(heading => (
              <li class:list={[{ 'toc-subheading': heading.depth === 3 }]}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), dateModified: (post.data.updated || post.data.date).toISOString(), author: { '@type': 'Person', name: 'Erossr' }, url: new URL(postUrl(post.data.slug), Astro.site).href }).replace(/</g, '\\u003c')} />
</Base>
