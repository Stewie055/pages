---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPosts, postUrl, tagUrl, formatDate } from '../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.data.slug }, props: { post, previous: posts[i + 1], next: posts[i - 1] } }));
}
const { post, previous, next } = Astro.props;
const { Content, headings } = await render(post);
const minutes = Math.max(1, Math.ceil((post.body || '').length / 600));
---
<Base title={post.data.title} description={post.data.description} article>
  <article class="article-page" data-pagefind-body>
    <header class="article-header">
      <a class="back-link" href="/">← 返回文章列表</a>
      <div class="post-tags">{post.data.tags.map(tag => <a href={tagUrl(tag)}>{tag}</a>)}</div>
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <div class="article-meta"><time datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time><span>约 {minutes} 分钟阅读</span>{post.data.updated && <span>更新于 {formatDate(post.data.updated)}</span>}</div>
    </header>
    <div class="article-grid">
      <div class="article-content">
        <aside class="historical-note" data-pagefind-ignore>这篇文章写于 {post.data.date.getUTCFullYear()} 年，保留了当时的实践记录。文中的软件版本、命令与服务现状可能已有变化。</aside>
        <div class="prose"><Content /></div>
        <div class="article-end"><span>— END —</span><a href="/rss.xml">通过 RSS 订阅后续文章 ↗</a></div>
        <nav class="article-pagination" aria-label="相邻文章" data-pagefind-ignore>{previous && <a href={postUrl(previous.data.slug)}><small>← 更早一篇</small>{previous.data.title}</a>}{next && <a href={postUrl(next.data.slug)}><small>更新一篇 →</small>{next.data.title}</a>}</nav>
      </div>
      {headings.length > 0 && <aside class="toc" data-pagefind-ignore><span class="eyebrow">本文目录</span><ol>{headings.filter(h => h.depth <= 3).map(h => <li style={`--depth:${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></aside>}
    </div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), dateModified: (post.data.updated || post.data.date).toISOString(), author: { '@type': 'Person', name: 'Erossr' }, url: new URL(postUrl(post.data.slug), Astro.site).href }).replace(/</g, '\\u003c')} />
</Base>
