---
import Base from '../../layouts/Base.astro';
import { getPosts, tagUrl } from '../../lib/posts';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap(p => p.data.tags))].map(tag => ({ tag, count: posts.filter(p => p.data.tags.includes(tag)).length })).sort((a,b) => b.count - a.count || a.tag.localeCompare(b.tag));
---
<Base title="标签">
  <div class="reading-width listing-page">
    <header class="page-heading"><h1>标签</h1></header>
    <ul class="tag-grid">
      {tags.map(({ tag, count }) => (
        <li><a href={tagUrl(tag)}>{tag}<small>{count} 篇</small></a></li>
      ))}
    </ul>
  </div>
</Base>
