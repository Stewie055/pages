---
import '../styles/global.css';
import { siteName } from '../lib/site';
interface Props { title?: string; description?: string; article?: boolean; }
const { title, description = 'Erossr 的技术博客。编程、Linux、调试、网络与工具。', article = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title || siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    <meta name="theme-color" content="#fcfbf8" />
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.dataset.theme = 'dark'; } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label={`${siteName}首页`}>{siteName}</a>
        <nav class="site-nav" aria-label="主导航">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>首页</a>
          <a href="/archives/" aria-current={pathname === '/archives/' ? 'page' : undefined}>归档</a>
          <a href="/tags/" aria-current={pathname.startsWith('/tags/') ? 'page' : undefined}>标签</a>
          <a href="/about/" aria-current={pathname === '/about/' ? 'page' : undefined}>关于</a>
        </nav>
        <div class="header-actions">
          <a href="/search/" class="icon-button" aria-label="搜索文章" aria-current={pathname === '/search/' ? 'page' : undefined}>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6"/><path d="m15 15 4.5 4.5"/></svg>
          </a>
          <button type="button" class="icon-button" id="theme-toggle" aria-label="深色模式" aria-pressed="false">
            <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linejoin="round"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
            <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M19 5l-1.5 1.5m-11 11L5 19"/></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <span>© {new Date().getFullYear()} Erossr</span>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
      function syncTheme() { button?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark')); }
      syncTheme();
      button?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('theme', theme); } catch {}
        syncTheme();
      });
      document.querySelectorAll<HTMLImageElement>('.prose img').forEach(image => {
        function showFallback() {
          const fallback = document.createElement('a');
          fallback.href = image.src;
          fallback.textContent = `${image.alt ? image.alt + '：' : ''}原图暂时无法加载，点击查看原图`;
          fallback.className = 'image-fallback';
          image.replaceWith(fallback);
        }
        image.addEventListener('error', showFallback, { once: true });
        if (image.complete && image.naturalWidth === 0) showFallback();
      });
    </script>
  </body>
</html>
